# ============================================================
# Warehouse IMS — docker compose environment variables
# ============================================================
# Copy this file to `.env` on VM1 and fill in real values.
# .env is gitignored — never commit it.
#   cp .env.example .env && nano .env
# ============================================================

# --- VM2 PostgreSQL (transactional DB) ---
# Use VM2's internal VNet IP (e.g., 10.0.1.X). Run `az vm list-ip-addresses -g rg-mit572-capstone -o table` from your WSL.
POSTGRES_HOST=10.0.1.5
POSTGRES_PASSWORD=ChangeMe_PG_2026!

# --- SQL Server data warehouse (runs as a container on VM1 via compose) ---
SA_PASSWORD=ChangeMe_SA_2026!

# --- JWT signing key — must be 32+ characters, random ---
# Generate with: openssl rand -base64 48
JWT_KEY=ReplaceWithARandom32PlusCharacterSigningKey!

# --- Active Directory (VM2) ---
AD_SERVER=10.0.1.5
AD_DOMAIN=capstone.local

# --- Public IP of VM1 (used for CORS origins) ---
# Get from: az vm show -d -g rg-mit572-capstone -n vm1-docker-host --query publicIps -o tsv
PUBLIC_IP=
